# Salin menjadi .backup-system.env di root bot (chmod 600). Jangan commit isi aslinya.
# Semua nilai opsional: tanpa variabel ini sistem tetap jalan dengan default aman.

# --- wajib untuk dashboard web (samakan dengan environment Vercel) ---
BACKUP_ADMIN_SECRET=ganti-dengan-random-48-hex

# --- scheduler ---
BACKUP_AUTOSTART=1
BACKUP_INTERVAL_MINUTES=10
BACKUP_RETENTION_COUNT=144
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
BACKUP_STORAGE_LIMIT_BYTES=2147483648
BACKUP_MIN_FREE_BYTES=268435456
BACKUP_LOCK_TIMEOUT_MINUTES=25

# --- lokasi data (default sudah benar untuk panel Pterodactyl) ---
# BACKUP_STORAGE_PATH=data/backup-system
# BACKUP_SQLITE_PATH=data/database/usanagi.sqlite
# BACKUP_DATABASE_JSON=database.json
# BACKUP_SESSIONS_DIR=sessions/jadibot
# BACKUP_PLATFORM_STATE=data/jadibot-platform.json

# --- enkripsi arsip (AES-256-GCM). 64 hex = 32 byte, atau passphrase. ---
# BACKUP_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION=1

# --- storage eksternal: none | vercel-blob | s3 ---
BACKUP_EXTERNAL_BACKEND=none
# all = setiap snapshot, hourly = sekali per jam, promoted = arsip harian
BACKUP_EXTERNAL_MODE=hourly
BLOB_READ_WRITE_TOKEN=
BLOB_BACKUP_PREFIX=backup-system
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=usanagi-backups

# --- bot Telegram (opsional; tanpa token fitur ini dimatikan) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_NOTIFY_SUCCESS=0

# --- Task83: tujuan arsip auto-backup harian (group Telegram bot utama) ---
# ID supergroup (diawali -100...). Bot utama harus admin di group itu.
# Tanpa nilai ini auto-backup tidak jalan (skip: telegram-not-configured),
# karena arsip tidak lagi dikirim ke nomor WhatsApp owner.
TELEGRAM_BACKUP_CHAT_ID=
